{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The Worker's name after the rename (ejc3/aws#415); claude-master-dashboard, the name before, is
  // retired and no longer deployed.
  "name": "claw-master-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // workers.dev is on now that Cloudflare Access covers the Worker (docs/deploy.md, step 3). Access
  // follows the Worker itself (an application with the Worker as its destination), so it gates
  // workers.dev and preview URLs alike once they are on. Wrangler applies these switches on each
  // deploy, so they change here and in ejc3/aws together.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The allowlist (docs/deploy.md): ejc3/aws writes it into this namespace, key allowed-emails, from
  // the same list as the Access policy. The real id is the production environment's
  // DASHBOARD_CONFIG_KV_ID variable, put in place of this placeholder by the Deploy workflow; the
  // placeholder names no namespace, so a deploy that skipped that step would fail, not admit anyone.
  "kv_namespaces": [{ "binding": "DASHBOARD_CONFIG", "id": "00000000000000000000000000000000" }]
  // The Access settings and the AWS key are Worker secrets (docs/deploy.md); they survive deploys.
}
