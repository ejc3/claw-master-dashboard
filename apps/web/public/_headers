# Next's build output is named by its content hash, so a file under /_next/static never changes:
# cache it for a year and never revalidate. Without this Workers serves it "max-age=0,
# must-revalidate", so every page load asks for the stylesheet again, through Cloudflare Access,
# and a refused or failed answer leaves the page unstyled.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
